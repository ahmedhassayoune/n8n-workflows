      "id": "2b720079-626e-429c-ba34-93b4387e65b2",
      "name": "Linkedin GET"
    },
    {
      "parameters": {
        "jsCode": "const cheerio = require('cheerio');\n\nfunction parseRelativeDate(text) {\n    const now = new Date();\n    const lower = text.toLowerCase();\n\n    const m = lower.match(/(\\d+)\\s*(minute|hour|day)s?\\s*ago/);\n    if (!m) return null;\n\n    const value = parseInt(m[1], 10);\n    const unit = m[2];\n\n    const d = new Date(now);\n\n    if (unit === \"minute\") d.setMinutes(now.getMinutes() - value);\n    if (unit === \"hour\")   d.setHours(now.getHours() - value);\n    if (unit === \"day\")    d.setDate(now.getDate() - value);\n\n    return d.toISOString();\n}\n\nfunction todayDate() {\n    const d = new Date();\n    d.setHours(0, 0, 0, 0);\n    return d.toISOString();\n}\n\n\nconst html = $input.first().json.data;\nconst $$ = cheerio.load(html);\n\nconst jobs = [];\n$$('.base-search-card').each((i, el) => {\n    const card = $$(el);\n\n    // Full job link\n    const link = card.find('a.base-card__full-link').attr('href') || null;\n\n    // Job ID from link\n    let jobId = null;\n    if (link) {\n        const match = link.match(/-(\\d+)(?:\\?|$)/);\n        jobId = match ? match[1] : null;\n    }\n\n    // Job title\n    const jobTitle =\n        card.find('.base-search-card__title').text().trim() ||\n        card.find('span.sr-only').text().trim() ||\n        null;\n\n    // Company name\n    const companyName =\n        card.find('.base-search-card__subtitle a').text().trim() ||\n        card.find('.base-search-card__subtitle').text().trim() ||\n        null;\n\n    // Extract the <time> element\n    const postedText = card.find('time').text().trim();\n    let postedAt = parseRelativeDate(postedText);\n\n    if (!postedAt) postedAt = todayDate();\n\n    jobs.push({\n        jobId,\n        jobTitle,\n        companyName,\n        link,\n        postedAt\n    });\n});\n\nconst url = $('Loop Over Scrolls').last().json.url;\n\nreturn [{ json: { url, jobs } }];\n"
      },
