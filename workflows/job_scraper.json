    {
      "parameters": {
        "jsCode": "const cheerio = require('cheerio');\n\nconst html = $input.first().json.data;\nconst $$ = cheerio.load(html);\n\nconst jobs = [];\n$$('.base-search-card').each((i, el) => {\n    const card = $$(el);\n\n    // Full job link\n    const link = card.find('a.base-card__full-link').attr('href') || null;\n\n    // Extract job ID from link (LinkedIn format always ends with ...-<id>?)\n    let jobId = null;\n    if (link) {\n        const match = link.match(/-(\\d+)(?:\\?|$)/);\n        jobId = match ? match[1] : null;\n    }\n\n    // Job title\n    const jobTitle = card.find('.base-search-card__title').text().trim() ||\n                     card.find('span.sr-only').text().trim() ||\n                     null;\n\n    // Company name\n    const companyName = card.find('.base-search-card__subtitle a').text().trim() ||\n                        card.find('.base-search-card__subtitle').text().trim() ||\n                        null;\n\n    jobs.push({\n        jobId,\n        jobTitle,\n        companyName,\n        link\n    });\n});\n\nconst url = $('Loop Over Scrolls').last().json.url;\n\nreturn [{ json: { url, jobs } }];\n"
      },
