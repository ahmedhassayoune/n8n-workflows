    {
      "parameters": {
        "jsCode": "const cheerio = require('cheerio');\n\nconst defaultCount = 100;\n\nfunction extract(input, cheerio) {\n  const $ = cheerio.load(input);\n\n  // Read the <title> text\n  const title = $('title').text().trim();\n\n  // Extract the first number in the title\n  const match = title.match(/\\d+/);\n  const count = match ? parseInt(match[0], 10) : defaultCount;\n\n  return {\n    offerCount: count\n  };\n}\n\nconst offerCount = extract($input.first().json.data, cheerio);\n\nreturn [{ json: offerCount }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        1360
      ],
      "id": "b17e147c-0325-42cc-8911-b67345bd9384",
      "name": "Extract Offers Count"
    },
    {
      "parameters": {
        "jsCode": "const initialURL = $('Loop Over URLs').last().json.url;\nconst offerCount = Math.min($input.first().json.offerCount, 200);\n\nconst defaultScrollURL = initialURL.replace(\n  \"https://www.linkedin.com/jobs/search/?\",\n    \"https://www.linkedin.com/jobs-guest/jobs/api/seeMoreJobPostings/search?\"\n) + \"&start=\";\n\nconst urls = [initialURL]\nfor (let i = 60; i < offerCount; i += 10) {\n  let newURL = defaultScrollURL + i;\n  urls.push(newURL);\n}\n\nreturn urls.map(url => ({ json: { url, jobs: [] }}))"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        864,
        1360
