    {
      "parameters": {
        "jsCode": "let jobs = $input.all().map(item => item.json);\n\nlet emailBody = 'Hello,\\n\\nHere are the new job opportunities today:\\n\\n';\n\njobs.forEach((job, index) => {\n  emailBody += `${index+1}) ${job.Title} — ${job.Company} — ${job.Location} — Posted: ${job['Posted Date']}\\n`;\n  emailBody += `    Skills: ${job['Profile Skills']}\\n`;\n  emailBody += `    Apply here: ${job['Apply URL']}\\n\\n`;\n});\n\nemailBody += `Total new positions: ${jobs.length}\\n`;\n\nreturn [{ json: { body: emailBody, nb_positions: jobs.length } }];"
      },
