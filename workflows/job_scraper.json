    {
      "parameters": {
        "jsCode": "const cheerio = require('cheerio');\n\nconst html = $input.first().json.data\nconst $$ = cheerio.load(html);\n\n// 1. Extract the JSON-LD script (LinkedIn job pages always include this)\nlet description = \"\";\n\n$$('script[type=\"application/ld+json\"]').each((i, el) => {\n    try {\n        const json = JSON.parse($$(el).contents().text());\n\n        // When the script contains a JobPosting\n        if (json['@type'] === 'JobPosting' && json.description) {\n            description = json.description;\n        }\n    } catch (e) {\n        // ignore parsing errors from other scripts\n    }\n});\n\n// 2. Clean HTML entities + line breaks\nif (description) {\n    // Remove HTML tags but keep line breaks\n    description = description\n        .replace(/<br\\s*\\/?>/gi, \"\\n\")\n        .replace(/<\\/?[^>]+>/g, \"\")\n        .trim();\n}\n\n// 3. Return in n8n format\nreturn [\n    {\n        json: {\n            jobDescription: description || null,\n        }\n    }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3456,
        736
      ],
      "id": "9e79dcfd-c56a-4826-8575-34d37665c419",
      "name": "Parse Job Description"
    },
    {
      "parameters": {
        "jsCode": "const TurndownService = require('turndown');\nconst he = require('he'); // decode HTML entities\n\nconst turndown = new TurndownService();\n\nconst escapedHtml = $input.first().json.jobDescription;\n\n// 1. Decode &lt; &gt; &amp; etc.\nconst realHtml = he.decode(escapedHtml);\n\n// 2. Convert to Markdown\nconst markdown = turndown.turndown(realHtml);\n\nreturn [ { json: { jobDescription: markdown } } ];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3680,
