    {
      "parameters": {
        "jsCode": "var urls = [];\n\nfor (const keyword of $input.first().json.keywords) {\n  var url = 'https://www.linkedin.com/jobs/search/?' \n    + 'keywords=' + encodeURIComponent(keyword)\n    + '&geoId=' + encodeURIComponent($input.first().json.geoId)\n    + '&f_TPR=' + encodeURIComponent($input.first().json.f_TPR);\n\n  urls.push(url);\n}\n\nreturn [\n  {\n    json: {\n      urls: urls\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
