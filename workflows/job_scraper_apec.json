      "parameters": {
        "jsCode": "const baseItem = $('Loop Over Payloads').last().json;\nconst totalCount = $input.first().json.totalCount;\n\nconst range = $('Set Query Params').first().json.paginationRange;\nconst nbPages = Math.ceil(totalCount / range);\n\nconst output = [];\n\nfor (let page = 0; page < nbPages; page++) {\n\n  const payload = JSON.parse(JSON.stringify(baseItem.payload));\n\n  payload.pagination.startIndex = page * range;\n\n  output.push({\n    json: {\n      payload,\n      jobs: [],\n      keyword: payload.motsCles,\n      page\n    }\n  });\n}\n\nreturn output;\n"
      },
