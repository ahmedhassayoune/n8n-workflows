    {
      "parameters": {
        "jsCode": "// Required libraries\nconst TurndownService = require('turndown');\nconst turndown = new TurndownService();\n\n// Experience lookup table\nconst experienceMap = {\n  200269: \"Tous niveaux d'expérience acceptés\",\n  597150: \"Aucune expérience exigée\",\n  597151: \"Minimum 1 an\",\n  597152: \"Minimum 2 ans\",\n  597153: \"Minimum 3 ans\",\n  597154: \"Minimum 4 ans\",\n  597155: \"Minimum 5 ans\",\n  597156: \"Minimum 6 ans\",\n  597157: \"Minimum 7 ans\",\n  597158: \"Minimum 8 ans\",\n  597159: \"Minimum 9 ans\",\n  597160: \"Minimum 10 ans\"\n};\n\nfunction formatDate(date) {\n  if (!date) return null;\n  const d = new Date(date);\n  const pad = (n) => String(n).padStart(2, '0');\n\n  const year = d.getFullYear();\n  const month = pad(d.getMonth() + 1); // Months are 0-indexed\n  const day = pad(d.getDate());\n\n  const hours = pad(d.getHours());\n  const minutes = pad(d.getMinutes());\n  const seconds = pad(d.getSeconds());\n\n  return `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;\n}\n\nconst hits = $input.all().map(item => item.json);\n\nconst mappedJobs = hits.map(job => {\n  // Decode HTML profile/description\n  const realHtml = job.jobDescription ?? '';\n  const descriptionMarkdown = turndown.turndown(realHtml);\n\n  // Construct job URL if possible\n  const baseUrl = 'https://www.apec.fr/candidat/recherche-emploi.html/emploi/detail-offre/';\n  const jobUrl = `${baseUrl}${job.hitResult.numeroOffre}`;\n\n  // Map experience using idNomenclature\n  const experienceId = job.experience;\n  const experience = experienceMap[experienceId] || '';\n\n  return {\n    id: job.id,\n    source: 'apec',\n    title: job.jobTitle,\n    company: job.companyName,\n    location: job.hitResult.lieuTexte,\n    salary: job.hitResult.salaireTexte || '',\n    descriptionSummary: job.hitResult.texteOffre || '',\n    description: descriptionMarkdown || '',\n    profileSkills: job.profileSkills || [],\n    url: jobUrl,\n    scrapedAt: $now.toFormat('yyyy-MM-dd HH:mm:ss'),\n    jobId: job.jobId,\n    postedAt: formatDate(job.hitResult.datePublication) || '',\n    experience: experience\n  };\n});\n\nreturn mappedJobs;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
