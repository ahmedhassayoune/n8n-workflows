      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst keywords = input.keywords;\nconst lieux = input.lieux;\nconst anciennetePublication = input.anciennetePublication;\nconst paginationRange = input.paginationRange;\n\nconst basePayload = {\n  lieux: lieux,\n  pagination: {\n    range: paginationRange,\n    startIndex: 0\n  },\n  sorts: [\n    { type: \"SCORE\", direction: \"DESCENDING\" }\n  ],\n  activeFiltre: true,\n  anciennetePublication: anciennetePublication\n};\n\nlet payloads = [];\n\nfor (const keyword of keywords) {\n  const payload = {\n    ...basePayload,\n    motsCles: keyword\n  };\n\n  payloads.push({\n    payload,\n    jobs: []\n  });\n}\n\nreturn payloads;\n"
      },
