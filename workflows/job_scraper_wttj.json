      "parameters": {
        "jsCode": "var requests = [];\nconst hitsPerPage = 50;\n\nconst input = $input.first().json;\n\n// build experience filter\nconst experienceFilters = input.experience_lvl\n  .map(lvl => {\n    const [min, max] = lvl.split('-');\n    return `experience_level_minimum:${min} TO ${max}`;\n  })\n  .join(' OR ');\n\n// build contract filter\nconst contractFilters = input.contract_type\n  .map(ct => `contract_type:\"${ct}\"`)\n  .join(' OR ');\n\n// base filters (not URL-encoded yet)\nconst filters = `(offices.country_code:\"${input.country}\" AND offices.state:\"${input.state}\") AND (${contractFilters}) AND (${experienceFilters})`;\n\nconst minTimestamp = Math.floor(Date.now() / 1000) - input.last_timestamp\nconst numericFilters = `published_at_timestamp>=${minTimestamp}`\n\nfor (const keyword of input.keywords) {\n\n  const params =\n    'query=' + encodeURIComponent(keyword) +\n    '&page=0' +\n    '&hitsPerPage=' + hitsPerPage +\n    '&filters=' + encodeURIComponent(filters) +\n    '&numericFilters=' + encodeURIComponent(numericFilters);\n\n  let request = { \n    indexName: \"wttj_jobs_production_fr\",\n    params: params\n  };\n\n  requests.push(request);\n}\n\nreturn requests.map(request => ({\n  request,\n  jobs: [],\n}));\n"
      },
