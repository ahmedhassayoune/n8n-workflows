    {
      "parameters": {
        "jsCode": "// Required libraries\nconst TurndownService = require('turndown');\nconst he = require('he'); // decode HTML entities\nconst turndown = new TurndownService();\n\nfunction formatDate(date) {\n  if (!date)\n    return null\n  const d = new Date(date);\n  const pad = (n) => String(n).padStart(2, '0');\n  \n  const year = d.getFullYear();\n  const month = pad(d.getMonth() + 1); // Months are 0-indexed\n  const day = pad(d.getDate());\n  \n  const hours = pad(d.getHours());\n  const minutes = pad(d.getMinutes());\n  const seconds = pad(d.getSeconds());\n  \n  return `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`;\n}\n\nconst hits = $input.all().map(item => item.json); // or $input.first().json.hits if single node\n\nconst mappedJobs = hits.map(job => {\n  // Decode HTML profile/description\n  const realHtml = job.hitResult.profile ? he.decode(job.hitResult.profile) : '';\n  const descriptionMarkdown = turndown.turndown(realHtml);\n\n  // Construct job URL if possible\n  const baseUrl = 'https://www.welcometothejungle.com/fr/companies/';\n  const companySlug = job.hitResult.organization?.slug || '';\n  const jobSlug = job.hitResult.slug || '';\n  const jobUrl = companySlug && jobSlug ? `${baseUrl}${companySlug}/jobs/${jobSlug}` : '';\n\n  const location = job.hitResult.offices?.[0] ? `${job.hitResult.offices[0].city}, ${job.hitResult.offices[0].state}` : ''\n\n  return {\n    id: job.id,\n    source: 'wttj',\n    title: job.jobTitle,\n    company: job.companyName,\n    location: location,\n    salary: job.hitResult.salary_minimum || job.hitResult.salary_maximum || null,\n    descriptionSummary: job.hitResult.summary || '',\n    description: descriptionMarkdown,\n    profileSkills: [],\n    url: jobUrl,\n    scrapedAt: $now.toFormat('yyyy-MM-dd HH:mm:ss'),\n    jobId: job.jobId,\n    postedAt: formatDate(job.hitResult.published_at) || job.hitResult.published_at_date || null,\n    experience: job.hitResult.has_experience_level_minimum ? `+${job.hitResult.experience_level_minimum} years` : null\n  };\n});\n\nreturn mappedJobs;\n"
      },
