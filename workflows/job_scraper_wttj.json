    {
      "parameters": {
        "jsCode": "const baseRequest = $('Loop Over Requests').last().json.request;\nconst nbPages = $input.first().json.nbPages;\n\nconst output = [];\n\nfor (let page = 0; page < nbPages; page++) {\n  const request = JSON.parse(JSON.stringify(baseRequest));\n  request.params = request.params.replace(/page=\\d+/, `page=${page}`);\n\n  output.push({\n    json: {\n      request,\n      jobs: []\n    }\n  });\n}\n\nreturn output;"
      },
